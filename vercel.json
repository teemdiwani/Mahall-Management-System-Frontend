{
  "rewrites": [
    {
      "source": "/api/mail-relay",
      "destination": "/api/mail-relay"
    },
    {
      "source": "/api/:path*",
      "destination": "https://mahall-management-system-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
